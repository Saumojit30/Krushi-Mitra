# =============================================================================
# Krushi Mitra — Environment Variables
# Cotton Farmer Voice Advisory Agent | Vidarbha, Maharashtra
# =============================================================================
# Copy this file to .env.local and fill in your actual keys.
# .env.local is gitignored — NEVER commit real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit — Audio Transport Layer
# Free tier available at: https://cloud.livekit.io
# Create a new project → Settings → API Keys
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Murf Falcon 2 — Text-to-Speech (Marathi voice)
# Get API key from: https://murf.ai/api/dashboard → API Keys
#
# To find the correct MURF_VOICE_ID for Marathi:
#   1. Call the Murf List Voices API:
#      GET https://api.murf.ai/v1/speech/voices
#      Authorization: Token YOUR_API_KEY
#   2. Filter response for: "locale": "mr-IN"
#   3. Copy the "voiceId" field of your chosen voice (e.g., "mr-IN-shilpa")
#
# IMPORTANT: Use model GEN2 (Falcon 2). GEN1/Gen2 deprecated Aug 16, 2026.
# -----------------------------------------------------------------------------
MURF_API_KEY=
MURF_VOICE_ID=mr-IN-shilpa
# Options for Marathi voices: check murf.ai/api/docs for full list

# -----------------------------------------------------------------------------
# Deepgram — Speech-to-Text (STT)
# Free tier: $200 credit on sign-up at https://console.deepgram.com
# Model: nova-3 with language=multi (handles Marathi + Hindi code-switching)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Groq — LLM (OpenAI-compatible API, fast inference)
# Free tier available at: https://console.groq.com
# Recommended model: llama-3.3-70b-versatile (active as of Aug 2026)
# Alternative: openai/gpt-oss-20b
# DO NOT use: llama-3.1-8b-instant (deprecated Aug 16, 2026)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Observability — Latency Logging
# Set LOG_LATENCY=true to log per-turn end-of-speech → first-audio latency
# Target: total latency < 1000ms on standard broadband
# -----------------------------------------------------------------------------
LOG_LATENCY=true
LOG_LEVEL=INFO
