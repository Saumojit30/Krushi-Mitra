# =============================================================================
# Krushi Mitra — Root .gitignore
# =============================================================================

# ---- Secrets (CRITICAL — never commit API keys) ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python

# ---- Test & lint caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- Node / Frontend ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/.next/
/frontend/out/
/frontend/build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs ----
.idea/
.vscode/
*.swp
*.swo
.cursor/chat/
.cursor/rules/*.local.mdc

# ---- AI coding tool locals ----
.claude/settings.local.json
.claude/worktrees/
.codex/config.local.toml
.gemini/history/
.gemini/tmp/
.gemini/google_accounts.json
.gemini/installation_id
.gemini/oauth_creds.json

# ---- LiveKit / ML model downloads ----
# These are downloaded via `uv run python src/agent.py download-files`
# and should not be committed (large binary files)
*.onnx
*.ort
*.pt
*.bin
*.safetensors
silero_vad/
models/

# ---- Logs ----
*.log
logs/
day*-latency-log.txt

# ---- Vercel / Railway deploy artifacts ----
.vercel
